# Copy to passwords.yaml and replace each placeholder with a unique local value.
development:
  database: 'replace-with-development-db-password'
  redis: 'replace-with-development-redis-password'
  serviceSecret: 'replace-with-local-service-secret'
  emailSecretHashPepper: 'replace-with-development-email-pepper'
  jwtHmacSha512PrivateKey: 'replace-with-development-signing-key'
  jwtRefreshTokenHashPepper: 'replace-with-development-refresh-pepper'

test:
  database: 'replace-with-test-db-password'
  redis: 'replace-with-test-redis-password'
  emailSecretHashPepper: 'replace-with-test-email-pepper'
  jwtHmacSha512PrivateKey: 'replace-with-test-signing-key'
  jwtRefreshTokenHashPepper: 'replace-with-test-refresh-pepper'
